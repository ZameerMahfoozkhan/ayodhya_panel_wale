# ==============================================================================
# PVC PANEL WALE - PRODUCTION APACHE CONFIGURATION (.htaccess)
# Clean URLs (removes .html), 301 Redirects, Caching, and Security
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # 1. 301 PERMANENT REDIRECTS FOR PREVIOUSLY INDEXED CITY PAGES
  # Redirects both /pvc-panels-city and /pvc-panels-city.html to clean URL
  # ----------------------------------------------------------------------
  RewriteRule ^pvc-panels-lucknow(\.html)?$ /pvc-panel-installation-lucknow [R=301,L]
  RewriteRule ^pvc-panels-gorakhpur(\.html)?$ /pvc-panel-installation-gorakhpur [R=301,L]
  RewriteRule ^pvc-panels-sultanpur(\.html)?$ /pvc-panel-installation-sultanpur [R=301,L]
  RewriteRule ^pvc-panels-gonda(\.html)?$ /pvc-panel-installation-gonda [R=301,L]
  RewriteRule ^pvc-panels-basti(\.html)?$ /pvc-panel-installation-basti [R=301,L]
  RewriteRule ^pvc-panels-amethi(\.html)?$ /pvc-panel-installation-amethi [R=301,L]
  RewriteRule ^pvc-panels-barabanki(\.html)?$ /pvc-panel-installation-barabanki [R=301,L]
  RewriteRule ^pvc-panels-ambedkar-nagar(\.html)?$ /pvc-panel-installation-ambedkar-nagar [R=301,L]

  # ----------------------------------------------------------------------
  # 2. REMOVE .html EXTENSION FROM EXTERNAL REQUESTS (301 Redirect)
  # Redirects example.com/page.html -> example.com/page
  # ----------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ----------------------------------------------------------------------
  # 3. INTERNALLY REWRITE CLEAN URL TO .html FILE
  # Maps example.com/page -> page.html seamlessly without changing URL bar
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

</IfModule>

# ----------------------------------------------------------------------
# 4. BROWSER CACHING (MOD_EXPIRES)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ----------------------------------------------------------------------
# 5. GZIP COMPRESSION (MOD_DEFLATE)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 6. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
